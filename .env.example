# ==============================================================================
# Environment Configuration Example
# ==============================================================================

# ==============================================================================
# Turso Database Configuration (Free 5GB Cloud SQLite / libSQL)
# ==============================================================================
# Get your database URL and Auth Token at https://turso.tech or using Turso CLI:
# 1. turso db create adsmonster-db
# 2. turso db show adsmonster-db --url
# 3. turso db tokens create adsmonster-db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# (Optional fallback) PostgreSQL Database Connection URL
DATABASE_URL=


# Session & JWT Secrets for Authentication (minimum 32 characters or 64-char hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_64_character_hex_session_secret_here
JWT_SECRET=your_random_64_character_hex_jwt_secret_here

# Admin Account Initial Credentials (for seed script)
ADMIN_EMAIL=admin@adsoxygen.com
ADMIN_PASSWORD=ChangeMe!2024Secure

# ==============================================================================
# Email Configuration (Nodemailer)
# ==============================================================================
# Email inbox where client inquiries from the contact form will be delivered:
CONTACT_RECEIVER_EMAIL=your-agency-email@example.com

# OPTION 1: Using Gmail (Easiest)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# (Note: Requires 2-Step Verification enabled on your Google account)
# SMTP_SERVICE=gmail
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# OPTION 2: Using Custom SMTP Server (Hostinger, cPanel, Zoho, Brevo, SendGrid, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use 'true' for port 465, 'false' for port 587 or 25
SMTP_SECURE=false
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=your-smtp-or-app-password

# Optional: Custom sender display name and address
SMTP_FROM="Ads Monster" <noreply@yourdomain.com>

# Optional: Automatically send a polite confirmation email to the client (true / false)
SEND_CLIENT_CONFIRMATION=true

# ==============================================================================
# Public Website Application URL
# ==============================================================================
# Set this to your production domain or keep localhost for development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Stripe Payment Configuration
# ==============================================================================
# 1. Sign up or log into Stripe: https://dashboard.stripe.com/
# 2. Get API keys at: https://dashboard.stripe.com/test/apikeys
# 3. For Webhooks: Add endpoint `https://your-domain.com/api/webhooks/stripe`
#    listening to `checkout.session.completed` and `payment_intent.succeeded`
#    at https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Webhook signing secret (obtained after creating your webhook endpoint in Stripe Dashboard or stripe listen)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ==============================================================================
# PayPal Payment Configuration
# ==============================================================================
# 1. Sign up or log into PayPal Developer: https://developer.paypal.com/dashboard/
# 2. Go to "Apps & Credentials" -> Create an App (REST API)
# 3. Mode: "sandbox" (for testing) or "live" (for real payments)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# Optional: PayPal Webhook ID from developer dashboard for https://your-domain.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here


