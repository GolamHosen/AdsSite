# ==============================================================================
# Environment Configuration Example
# ==============================================================================

# PostgreSQL Database Connection URL
# Replace this with your actual database connection string (e.g. Supabase, Neon, AWS RDS, or local Postgres)
# Example: postgresql://postgres:yourpassword@localhost:5432/adsoxygen_db
DATABASE_URL=

# Session Secret for Admin Authentication (minimum 32 characters)
SESSION_SECRET=your_random_32_characters_session_secret_here

# Admin Account Initial Credentials (for seed script)
ADMIN_EMAIL=admin@adsoxygen.com
ADMIN_PASSWORD=ChangeMe!2024Secure
